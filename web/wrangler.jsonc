// Cloudflare Workers: publica la web ya compilada (dist/) como archivos estáticos.
{
  "name": "willo",
  "compatibility_date": "2026-11-01",
  // Wrangler compila antes de publicar: las versiones de prueba de los PRs no lanzan `npm run build`.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Necesario para `wrangler preview` (versiones de prueba de cada rama y PR).
  "previews": {}
}
